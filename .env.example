# Sin estas variables la app corre en MODO DEMO (datos en memoria y pago simulado).

# Supabase → Project Settings → API (solo servidor, NUNCA con NEXT_PUBLIC_)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Contraseña del panel del negocio
PANEL_PASSWORD=

# Mercado Pago → Tus integraciones → Credenciales de producción / prueba
MP_ACCESS_TOKEN=
# Mercado Pago → Webhooks → Clave secreta (valida la firma de las notificaciones)
MP_WEBHOOK_SECRET=

# Vercel Cron lo manda en el header Authorization
CRON_SECRET=

# Opcional: recordatorios automáticos con WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=

# URL pública (para los links de Mercado Pago y recordatorios)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
